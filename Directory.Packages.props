<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Tests -->
    <PackageVersion Include="coverlet.collector" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Resilience" Version="10.9.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="Microsoft.Testing.Platform" Version="2.3.3" />
    <PackageVersion Include="Testcontainers.LocalStack" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.PubSub" Version="4.14.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="FluentAssertions" Version="[8.1.1]" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="RichardSzalay.MockHttp" Version="7.1.0" />
    <PackageVersion Include="Testcontainers" Version="4.13.0" />
    <PackageVersion Include="Testcontainers.MongoDb" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.MySql" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.14.0" />
    <!-- Data Providers -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <!-- File Providers -->
    <PackageVersion Include="CsvHelper" Version="33.1.0" />
    <PackageVersion Include="Parquet.Net" Version="6.1.0" />
    <!-- Queue Providers -->
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
    <PackageVersion Include="Google.Cloud.PubSub.V1" Version="3.37.0" />
    <PackageVersion Include="AWSSDK.SQS" Version="4.0.100.11" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.33.0.1635" />
    <PackageVersion Include="MinVer" Version="7.0.0" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="Refit" Version="[10.2.0]" />
    <PackageVersion Include="Refit.HttpClientFactory" Version="[10.2.0]" />
    <PackageVersion Include="MongoDB.Driver" Version="3.11.0" />
  </ItemGroup>
</Project>